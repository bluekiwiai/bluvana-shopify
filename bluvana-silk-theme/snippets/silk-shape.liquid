{%- comment -%}
  Placeholder garment silhouette. Six distinct shapes so the category row reads
  as navigation before any photography exists. Replaced tile by tile as real
  ghost mannequin cut outs land.
  Params: idx (0-5, picks shape + color) | fill | tall | pair
{%- endcomment -%}

{%- liquid
  assign swatches = '#a81b34,#2a2725,#e8e3dc,#8f2b3f,#dcd6d0,#25473a' | split: ','
  assign pick = idx | default: 0 | modulo: 6
  assign tint = swatches[pick]
  if fill != blank
    assign tint = fill
  endif
  assign uid = pick | append: tall | append: pair
-%}

{%- if pair -%}
  <svg class="sk-svg" viewBox="0 0 320 400" aria-hidden="true" focusable="false">
    <path d="M30 396c-7-62 5-120 17-168 9-36 8-62 0-92 24 14 46 20 61 20s37-6 61-20c-8 30-9 56 0 92 12 48 24 106 17 168z" fill="#a81b34" opacity=".9"/>
    <path d="M161 396c-7-62 5-120 17-168 9-36 8-62 0-92 24 14 46 20 61 20s37-6 61-20c-8 30-9 56 0 92 12 48 24 106 17 168z" fill="#e8e3dc" opacity=".88"/>
    <path d="M108 136v260M239 136v260" stroke="#141212" stroke-width="1.2" opacity=".3" fill="none"/>
  </svg>

{%- elsif tall -%}
  <svg class="sk-svg" viewBox="0 0 300 400" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="sks{{ uid }}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="{{ tint }}" stop-opacity="1"/>
        <stop offset="48%" stop-color="{{ tint }}" stop-opacity=".62"/>
        <stop offset="100%" stop-color="{{ tint }}" stop-opacity=".92"/>
      </linearGradient>
    </defs>
    <path d="M64 396c-9-66 5-128 20-179 11-39 9-66 0-98 26 15 50 21 66 21s40-6 66-21c-9 32-11 59 0 98 15 51 29 113 20 179z" fill="url(#sks{{ uid }})"/>
    <path d="M150 140v256" stroke="#f2f0ee" stroke-width="1.3" opacity=".42" fill="none"/>
    <path d="M150 140c-15 21-32 32-49 38M150 140c15 21 32 32 49 38" stroke="#f2f0ee" stroke-width="1.1" opacity=".32" fill="none"/>
  </svg>

{%- else -%}
  <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
    <ellipse cx="100" cy="191" rx="52" ry="5" fill="#1a1817" opacity=".09"/>

    {%- case pick -%}

      {%- when 0 -%}
        {%- comment -%} Long sleeve set: shirt with sleeves over full pants {%- endcomment -%}
        <path d="M70 44c10 7 20 10 30 10s20-3 30-10l22 11c7 4 9 8 8 15l-5 26-14-4 3 42H56l3-42-14 4-5-26c-1-7 1-11 8-15z" fill="{{ tint }}"/>
        <path d="M58 138h84l4 32-6 26h-30l-6-40h-8l-6 40H60l-6-26z" fill="{{ tint }}" opacity=".82"/>
        <path d="M100 54v80" stroke="#f2f0ee" stroke-width="1.2" opacity=".45" fill="none"/>

      {%- when 1 -%}
        {%- comment -%} Short set: camisole over shorts {%- endcomment -%}
        <path d="M76 40c6 9 15 14 24 14s18-5 24-14l14 8c5 3 6 7 5 12l-6 62H63l-6-62c-1-5 0-9 5-12z" fill="{{ tint }}"/>
        <path d="M62 128h76l5 24-4 28h-27l-7-30h-10l-7 30H61l-4-28z" fill="{{ tint }}" opacity=".82"/>
        <path d="M100 54v68" stroke="#f2f0ee" stroke-width="1.2" opacity=".45" fill="none"/>
        <path d="M78 40 74 22M122 40l4-18" stroke="{{ tint }}" stroke-width="2.4" fill="none"/>

      {%- when 2 -%}
        {%- comment -%} Slip dress: one long bias cut piece {%- endcomment -%}
        <path d="M78 44c5 8 13 12 22 12s17-4 22-12l12 7c4 3 5 6 4 10l-8 42 6 83H68l6-83-8-42c-1-4 0-7 4-10z" fill="{{ tint }}"/>
        <path d="M100 56v130" stroke="#f2f0ee" stroke-width="1.2" opacity=".42" fill="none"/>
        <path d="M80 44 76 24M120 44l4-20" stroke="{{ tint }}" stroke-width="2.2" fill="none"/>

      {%- when 3 -%}
        {%- comment -%} Robe: belted, open front, full length {%- endcomment -%}
        <path d="M68 42c10 8 21 12 32 12s22-4 32-12l24 12c8 4 10 9 9 16l-7 30-13-4 5 90H50l5-90-13 4-7-30c-1-7 1-12 9-16z" fill="{{ tint }}"/>
        <path d="M100 54 82 186M100 54l18 132" stroke="#f2f0ee" stroke-width="1.4" opacity=".4" fill="none"/>
        <rect x="46" y="112" width="108" height="9" rx="4" fill="#f2f0ee" opacity=".5"/>
        <path d="M100 121c-6 10-6 20-2 30M100 121c6 10 6 20 2 30" stroke="#f2f0ee" stroke-width="1.8" opacity=".45" fill="none"/>

      {%- when 4 -%}
        {%- comment -%} Lace trim: chemise, A line, scalloped hem {%- endcomment -%}
        <path d="M78 44c5 8 13 12 22 12s17-4 22-12l13 7c5 3 6 7 5 11l-14 100H74L60 62c-1-4 0-8 5-11z" fill="{{ tint }}"/>
        <path d="M74 162h52l-1 8-6-5-5 6-6-6-6 6-6-6-6 6-6-6-6 5z" fill="{{ tint }}" opacity=".55"/>
        <path d="M100 56v106" stroke="#f2f0ee" stroke-width="1.2" opacity=".42" fill="none"/>
        <path d="M80 44 76 24M120 44l4-20" stroke="{{ tint }}" stroke-width="2.2" fill="none"/>

      {%- else -%}
        {%- comment -%} Three piece: two garments overlapping {%- endcomment -%}
        <path d="M46 60c7 6 15 9 23 9s16-3 23-9l17 9c6 3 7 7 6 12l-11 108H34L23 81c-1-5 0-9 6-12z" fill="{{ tint }}" opacity=".95"/>
        <path d="M108 52c8 7 17 10 26 10s18-3 26-10l19 10c7 4 8 8 7 13l-12 114h-80l-12-114c-1-5 0-9 7-13z" fill="#e8e3dc" opacity=".9"/>
        <path d="M69 71v118M134 64v125" stroke="#f2f0ee" stroke-width="1.2" opacity=".4" fill="none"/>

    {%- endcase -%}
  </svg>
{%- endif -%}
