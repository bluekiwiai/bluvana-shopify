{% liquid
  assign shop_url = routes.all_products_collection_url
  assign cols = section.settings.columns | split: '§'
  assign badges = section.settings.badges | split: '§'
%}

{%- capture icon_ship -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2.5 7.5h10v9h-10z"/><path d="M12.5 11h4l3 3v2.5h-7z"/>
    <circle cx="7" cy="18.5" r="2"/><circle cx="16.5" cy="18.5" r="2"/>
  </svg>
{%- endcapture -%}

{%- capture icon_return -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3.5 12a8.5 8.5 0 1 1 2.6 6.1"/><path d="M3.5 6.5v5h5"/>
  </svg>
{%- endcapture -%}

{%- capture icon_lock -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="4.5" y="10.5" width="15" height="10" rx="2"/>
    <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
  </svg>
{%- endcapture -%}

{%- capture icon_chat -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.5 12.5a7.5 7.5 0 0 1-10.9 6.7L4 20.5l1.4-5.4A7.5 7.5 0 1 1 20.5 12.5z"/>
  </svg>
{%- endcapture -%}

{%- assign icons = icon_ship | append: '||' | append: icon_return | append: '||' | append: icon_lock | append: '||' | append: icon_chat -%}
{%- assign icon_list = icons | split: '||' -%}

<footer class="sk-foot">
  {%- comment -%} trust badges {%- endcomment -%}
  <div class="sk-foot__trust">
    {%- for b in badges -%}
      {%- assign bp = b | split: '|' -%}
      <div class="sk-foot__badge">
        <span class="sk-foot__icon">{{ icon_list[forloop.index0] }}</span>
        <span class="sk-foot__badge-t">{{ bp[0] | strip }}</span>
        <span class="sk-foot__badge-n">{{ bp[1] | strip }}</span>
      </div>
    {%- endfor -%}
  </div>

  {%- comment -%} links left, newsletter right {%- endcomment -%}
  <div class="sk-foot__main">
    <div class="sk-foot__links">
      {%- for col in cols -%}
        {%- assign parts = col | split: '|' -%}
        <div>
          <h3>{{ parts[0] | strip }}</h3>
          <ul>
            {%- for j in (1..8) -%}
              {%- assign item = parts[j] -%}
              {%- if item != blank -%}
                <li><a href="{{ shop_url }}">{{ item | strip }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    <div class="sk-foot__connect">
      <h3 class="sk-foot__connect-t">{{ section.settings.connect_title | default: 'Stay connected' }}</h3>
      <p class="sk-foot__connect-p">
        {{ section.settings.connect_body | default: 'New pieces, restocks and early access. Nothing else.' }}
      </p>

      {% form 'customer', class: 'sk-foot__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="sk-visually-hidden" for="sk-news">Email address</label>
        <input id="sk-news" type="email" name="contact[email]" placeholder="Your email address" required autocomplete="email">
        <button type="submit" aria-label="Subscribe">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h14"/><path d="m12.5 6 6 6-6 6"/></svg>
        </button>
        {%- if form.posted_successfully? -%}
          <p class="sk-foot__ok">Thank you. You are on the list.</p>
        {%- endif -%}
      {% endform %}

      <ul class="sk-foot__social">
        {%- assign socials = 'Instagram|TikTok|Pinterest' | split: '|' -%}
        {%- for sname in socials -%}
          <li><a href="{{ section.settings.social_link | default: '#' }}" aria-label="{{ sname }}">{{ sname }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  {%- comment -%} logo {%- endcomment -%}
  <div class="sk-foot__logo">
    <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <img src="{{ 'silk-wordmark-light.png' | asset_url }}" alt="{{ shop.name | escape }}" width="542" height="180" loading="lazy">
    </a>
  </div>

  <div class="sk-foot__bar">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>{{ section.settings.legal | default: 'OEKO-TEX Standard 100 certified' }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Silk footer",
  "settings": [
    {
      "type": "textarea",
      "id": "badges",
      "label": "Trust badges (Title|Note, separated by §)",
      "default": "Free shipping|On every order over $100§30 day returns|Unworn, in the original box§Secure checkout|Encrypted, never stored§Real people|We reply within a day"
    },
    {
      "type": "textarea",
      "id": "columns",
      "label": "Footer columns (section separated by §, items by |)",
      "default": "Shop|Long sleeve sets|Short sets|Slip dresses|Robes|Lace trim|Sets§Help|Shipping|Returns|Size guide|Silk care|Contact§About|Our silk|How we make it|Certification|Journal"
    },
    { "type": "text", "id": "connect_title", "label": "Newsletter title", "default": "Stay connected" },
    { "type": "text", "id": "connect_body", "label": "Newsletter body", "default": "New pieces, restocks and early access. Nothing else." },
    { "type": "url", "id": "social_link", "label": "Social link" },
    { "type": "text", "id": "legal", "label": "Legal line", "default": "OEKO-TEX Standard 100 certified" }
  ]
}
{% endschema %}
