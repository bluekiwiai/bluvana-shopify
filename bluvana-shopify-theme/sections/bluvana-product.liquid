{{ 'bluvana-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bluvana-product.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign color_index = 0
  assign purchase_index = 0
  for option in product.options_with_values
    if option.name == 'Color'
      assign color_index = forloop.index
    endif
    if option.name == 'Purchase'
      assign purchase_index = forloop.index
    endif
  endfor
  if purchase_index == 0 and product.options.size == 1
    assign purchase_index = 1
  endif

  case product.handle
    when 'shower-filter'
      assign bvp_solo_label = 'Filter only'
      assign bvp_bundle_label = 'Filter + 3 cartridges'
    when 'multi-spray-showerhead'
      assign bvp_solo_label = 'Showerhead only'
      assign bvp_bundle_label = 'Showerhead + 3 cartridges'
    when 'luxe-flow-showerhead'
      assign bvp_solo_label = 'Showerhead only'
      assign bvp_bundle_label = 'Showerhead + 3 cartridges'
    when 'replacement-cartridges'
      assign bvp_solo_label = 'Single cartridge'
      assign bvp_bundle_label = '3-pack'
    else
      assign bvp_solo_label = 'One time'
      assign bvp_bundle_label = 'Bundle'
  endcase

  assign bvp_cart3_variant = null
  if product.handle != 'replacement-cartridges'
    assign bvp_cart_product = all_products['replacement-cartridges']
    if bvp_cart_product
      for v in bvp_cart_product.variants
        assign vt = v.title | downcase
        if vt contains '3'
          assign bvp_cart3_variant = v
        endif
      endfor
      if bvp_cart3_variant == null
        assign bvp_cart3_variant = bvp_cart_product.selected_or_first_available_variant
      endif
    endif
  endif
%}

<div
  class="bvp"
  data-bvp
  data-handle="{{ product.handle }}"
  data-color-index="{{ color_index }}"
  data-purchase-index="{{ purchase_index }}"
>

  {% # ================= BUY BOX ================= %}
  <section class="bvp-hero" id="bv-buy" aria-label="{{ product.title | escape }}">
    <div class="bvp-gallery" data-bvp-gallery>
      <div class="bvp-stage">
        {% for media in product.media %}
          <img
            class="bvp-stage-img{% if forloop.first %} is-active{% endif %}"
            src="{{ media | image_url: width: 1200 }}"
            width="1200"
            height="1800"
            {% unless forloop.first %}loading="lazy"{% endunless %}
            alt="{{ media.alt | default: product.title | escape }}"
            data-bvp-slide="{{ forloop.index0 }}"
            data-media-id="{{ media.id }}"
          >
        {% endfor %}
        {% if product.media.size > 1 %}
          <button type="button" class="bvp-stage-arrow bvp-stage-arrow--prev" data-bvp-prev aria-label="Previous image">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10.5 2.5 5 8l5.5 5.5"/></svg>
          </button>
          <button type="button" class="bvp-stage-arrow bvp-stage-arrow--next" data-bvp-next aria-label="Next image">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.5 2.5 11 8l-5.5 5.5"/></svg>
          </button>
        {% endif %}
      </div>
      <div class="bvp-thumbs" role="tablist" aria-label="Product images">
        {% for media in product.media %}
          <button
            type="button"
            role="tab"
            class="bvp-thumb{% if forloop.first %} is-active{% endif %}"
            aria-label="Image {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-bvp-thumb="{{ forloop.index0 }}"
          >
            <img src="{{ media | image_url: width: 160 }}" width="80" height="80" loading="lazy" alt="">
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="bvp-buy">
      <a class="bvp-rating" href="#bvp-reviews">
        <span class="bvp-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <b>4.9</b>
        <span class="bvp-rating-chip">250+ reviews</span>
      </a>

      <h1 class="bvp-title">{{ product.title }}</h1>

      {% if color_index > 0 %}
        <div class="bvp-colors" data-bvp-colors>
          <span class="bvp-colors-label">Color: <b data-bvp-color-name></b><em class="bvp-soldout-tag" data-bvp-color-soldout hidden>Sold out</em></span>
          <div class="bvp-swatches">
            {% assign color_option = product.options_with_values | where: 'name', 'Color' | first %}
            {% assign ci0 = color_index | minus: 1 %}
            {% for value in color_option.values %}
              {% assign color_avail = false %}
              {% for variant in product.variants %}
                {% if variant.options[ci0] == value and variant.available %}
                  {% assign color_avail = true %}
                  {% break %}
                {% endif %}
              {% endfor %}
              {% comment %} Gold is intentionally shown as sold out on the Shower Filter Pro page. {% endcomment %}
              {% if product.handle == 'shower-filter' and value == 'Gold' %}
                {% assign color_avail = false %}
              {% endif %}
              <label class="bvp-swatch bvp-swatch--{{ value | handleize }}{% unless color_avail %} is-soldout{% endunless %}" title="{{ value }}{% unless color_avail %} — sold out{% endunless %}">
                <input type="radio" name="bvp-color" value="{{ value | escape }}" {% if forloop.first %}checked{% endif %} data-bvp-color data-available="{{ color_avail }}">
                <span></span>
              </label>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <ul class="bvp-claims" role="list">
        {% case product.handle %}
          {% when 'shower-filter' %}
            <li>Stops the post-shower itch from the very first shower.</li>
            <li>20 stages catch the chlorine, rust and sediment behind it.</li>
            <li>Calmer skin in 30 days, or your money back.</li>
          {% when 'multi-spray-showerhead' %}
            <li>Stops the post-shower itch from the very first shower.</li>
            <li>The 20-stage filter is built into the head. Six spray settings.</li>
            <li>Calmer skin in 30 days, or your money back.</li>
          {% when 'luxe-flow-showerhead' %}
            <li>Stops the post-shower itch from the very first shower.</li>
            <li>Rain-style face in polished chrome, 20-stage filter inside.</li>
            <li>Calmer skin in 30 days, or your money back.</li>
          {% when 'replacement-cartridges' %}
            <li>Fits every Bluvana filter and filtered showerhead.</li>
            <li>Swap in seconds, no tools.</li>
            <li>One cartridge is about 3 months of filtered showers.</li>
          {% else %}
            <li>20-stage filtration in every shower.</li>
        {% endcase %}
      </ul>

      {% form 'product', product, class: 'bvp-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-bvp-id>

        <div class="bvp-offers" role="radiogroup" aria-label="Purchase options">
          <label class="bvp-offer bvp-offer--bundle is-active" data-bvp-offer="bundle" data-bvp-offer-hide>
            <span class="bvp-offer-ribbon" aria-hidden="true">Most popular</span>
            <span class="bvp-offer-head">
              <input type="radio" name="bvp-purchase" value="bundle" checked>
              <span class="bvp-offer-name">{{ bvp_bundle_label }}</span>
              <span class="bvp-offer-price">
                <s data-bvp-bundle-compare></s>
                <b data-bvp-bundle-price></b>
              </span>
              <span class="bvp-offer-save" data-bvp-save-chip></span>
            </span>
            <ul class="bvp-offer-checks" role="list">
              {% if product.handle == 'replacement-cartridges' %}
                <li>A full year of filtered showers</li>
                <li>Cheaper than buying one at a time</li>
                <li>Swap with the seasons</li>
                <li>30-day risk-free returns</li>
              {% else %}
                <li>No post-shower itch</li>
                <li>Calmer, softer skin and hair</li>
                <li>A full year of cartridges</li>
                <li>30-day risk-free returns</li>
              {% endif %}
            </ul>
            <span class="bvp-offer-sub">One fresh cartridge every 3 months. Under 20&cent; a day for a year of soft water.</span>
          </label>

          <label class="bvp-offer" data-bvp-offer="solo">
            <span class="bvp-offer-head">
              <input type="radio" name="bvp-purchase" value="solo">
              <span class="bvp-offer-name">{{ bvp_solo_label }}</span>
              <span class="bvp-offer-price"><b data-bvp-solo-price></b></span>
            </span>
          </label>

          {% if bvp_cart3_variant %}
            <label class="bvp-offer" data-bvp-offer="cartridges">
              <span class="bvp-offer-head">
                <input type="radio" name="bvp-purchase" value="cartridges">
                <span class="bvp-offer-name">Cartridges only · 3-pack</span>
                <span class="bvp-offer-price"><b>{{ bvp_cart3_variant.price | money }}</b></span>
              </span>
              <span class="bvp-offer-sub">Just the refills. A year of filtered showers, fits every Bluvana filter.</span>
            </label>
          {% endif %}
        </div>

        <div class="bvp-buyrow">
          <div class="bvp-qty" data-bvp-qty>
            <button type="button" data-bvp-qty-minus aria-label="Decrease quantity">&minus;</button>
            <input type="text" name="quantity" value="1" inputmode="numeric" aria-label="Quantity" data-bvp-qty-input>
            <button type="button" data-bvp-qty-plus aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" class="bvp-atc" data-bvp-atc><span data-bvp-atc-label>Add to cart &middot;&nbsp;</span><span data-bvp-total>{{ product.selected_or_first_available_variant.price | money }}</span></button>
        </div>
        {% comment %}
          Dynamic wallet button intentionally omitted until Shopify Payments is
          activated with Apple Pay enabled and Shop Pay disabled. Restore with:
          {{ form | payment_button }}
        {% endcomment %}

        <ul class="bvp-assure" role="list">
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 6.5h11.5v9H2.5z"/><path d="M14 9.8h4l3.5 3.4v2.3H14"/><circle cx="7" cy="17.6" r="1.7"/><circle cx="17.3" cy="17.6" r="1.7"/></svg>Free US shipping</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8 19 5.6v5.1c0 4.4-2.9 7.8-7 9.5-4.1-1.7-7-5.1-7-9.5V5.6z"/><path d="M8.8 11.6l2.3 2.3 4.3-4.3"/></svg>30-day returns</li>
          <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V10a8 8 0 0 1 16 0v1"/><path d="M15.8 14h8.2"/><path d="M20 11v3"/><path d="M17.8 17v1.8M22.2 17v1.8"/></svg>Fits standard arms</li>
        </ul>
      {% endform %}

      <div class="bvp-tabs" data-bvp-tabs>
        <div class="bvp-tab-nav" role="tablist">
          <button type="button" class="is-active" role="tab" data-bvp-tab="benefits">Benefits</button>
          <button type="button" role="tab" data-bvp-tab="how">How to use</button>
          <button type="button" role="tab" data-bvp-tab="box">Box contents</button>
          <button type="button" role="tab" data-bvp-tab="shipping">Shipping &amp; returns</button>
        </div>
        <div class="bvp-tab-panel is-active" data-bvp-panel="benefits">
          <ul class="bvp-check-grid" role="list">
            <li>No post-shower itch</li>
            <li>Calmer, softer skin</li>
            <li>Shinier, easier hair</li>
            <li>No chlorine smell</li>
            <li>Keeps your pressure</li>
            <li>5-minute install</li>
          </ul>
        </div>
        <div class="bvp-tab-panel" data-bvp-panel="how">
          <ol class="bvp-mini-steps" role="list">
            <li>Unscrew your showerhead by hand.</li>
            <li>Thread the filter onto the arm. Hand tight.</li>
            <li>Reattach, run hot water for one minute. Done.</li>
          </ol>
        </div>
        <div class="bvp-tab-panel" data-bvp-panel="shipping">
          <ul class="bvp-check-grid" role="list">
            <li>Free tracked US shipping on every order</li>
            <li>Ships in 1&ndash;2 business days, arrives in 2&ndash;5</li>
            <li>30-day risk-free returns &mdash; full refund, no restocking fee</li>
            <li>Start a return from your order email in seconds</li>
          </ul>
        </div>
        <div class="bvp-tab-panel" data-bvp-panel="box">
          <ul class="bvp-check-grid" role="list">
            {% case product.handle %}
              {% when 'replacement-cartridges' %}
                <li>20-stage cartridge, sealed</li>
                <li>Fits all Bluvana housings</li>
              {% else %}
                <li>Polished chrome housing</li>
                <li>20-stage cartridge, installed</li>
                <li>Thread seal tape</li>
                <li>Install guide</li>
            {% endcase %}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {% # ================= SPEC STRIP ================= %}
  <ul class="bvp-strip" role="list">
    <li><svg class="bvp-strip-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8s5.8 6.4 5.8 10.7a5.8 5.8 0 1 1-11.6 0C6.2 9.2 12 2.8 12 2.8z"/></svg><span>20-stage cartridge</span></li>
    <li><svg class="bvp-strip-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l1.9 5.6 5.6 1.9-5.6 1.9L12 18.5l-1.9-5.6-5.6-1.9 5.6-1.9z"/></svg><span>Chlorine <i class="bvp-strip-dot" aria-hidden="true">&middot;</i> rust <i class="bvp-strip-dot" aria-hidden="true">&middot;</i> sediment</span></li>
    <li><svg class="bvp-strip-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.6 6.3a4.2 4.2 0 0 0-5.7 5.2L3 17.4V21h3.6l5.9-5.9a4.2 4.2 0 0 0 5.2-5.7l-3 3-2.6-.7-.7-2.6z"/></svg><span>5-minute install</span></li>
    <li><svg class="bvp-strip-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1"/><path d="M3.5 3.5v5h5"/></svg><span>30-day returns</span></li>
    <li class="bvp-strip-clone" aria-hidden="true"><svg class="bvp-strip-ico" viewBox="0 0 24 24"><path d="M12 2.8s5.8 6.4 5.8 10.7a5.8 5.8 0 1 1-11.6 0C6.2 9.2 12 2.8 12 2.8z"/></svg><span>20-stage cartridge</span></li>
    <li class="bvp-strip-clone" aria-hidden="true"><svg class="bvp-strip-ico" viewBox="0 0 24 24"><path d="M12 3.5l1.9 5.6 5.6 1.9-5.6 1.9L12 18.5l-1.9-5.6-5.6-1.9 5.6-1.9z"/></svg><span>Chlorine <i class="bvp-strip-dot">&middot;</i> rust <i class="bvp-strip-dot">&middot;</i> sediment</span></li>
    <li class="bvp-strip-clone" aria-hidden="true"><svg class="bvp-strip-ico" viewBox="0 0 24 24"><path d="M14.6 6.3a4.2 4.2 0 0 0-5.7 5.2L3 17.4V21h3.6l5.9-5.9a4.2 4.2 0 0 0 5.2-5.7l-3 3-2.6-.7-.7-2.6z"/></svg><span>5-minute install</span></li>
    <li class="bvp-strip-clone" aria-hidden="true"><svg class="bvp-strip-ico" viewBox="0 0 24 24"><path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1"/><path d="M3.5 3.5v5h5"/></svg><span>30-day returns</span></li>
  </ul>

  {% # ================= THE SOLUTION ================= %}
  <section class="bvp-solution" aria-labelledby="bvp-solution-title">
    <div class="bvp-solution-copy">
      <h2 id="bvp-solution-title" class="bvp-serif">It&rsquo;s not sensitive skin. It&rsquo;s harsh water.</h2>
      <p class="bvp-oneliner">Tight, itchy skin after every shower? That&rsquo;s the water, not you.</p>
      <p class="bvp-removes-label">What it catches before it touches you</p>
      <ul class="bvp-x-grid" role="list">
        <li class="bvp-x-item">
          <span class="bvp-x-ico" aria-hidden="true"></span>
          <button type="button" class="bvp-x-name" aria-expanded="false" aria-describedby="bvp-tip-1">Chlorine</button>
          <span class="bvp-x-tip" role="tooltip" id="bvp-tip-1">Strips your skin&rsquo;s natural oils. Hello, dry and itchy.</span>
        </li>
        <li class="bvp-x-item">
          <span class="bvp-x-ico" aria-hidden="true"></span>
          <button type="button" class="bvp-x-name" aria-expanded="false" aria-describedby="bvp-tip-2">Rust flakes</button>
          <span class="bvp-x-tip" role="tooltip" id="bvp-tip-2">From old city pipes. Irritates sensitive skin.</span>
        </li>
        <li class="bvp-x-item">
          <span class="bvp-x-ico" aria-hidden="true"></span>
          <button type="button" class="bvp-x-name" aria-expanded="false" aria-describedby="bvp-tip-3">Sediment</button>
          <span class="bvp-x-tip" role="tooltip" id="bvp-tip-3">Fine grit that ends up clogging your pores.</span>
        </li>
        <li class="bvp-x-item">
          <span class="bvp-x-ico" aria-hidden="true"></span>
          <button type="button" class="bvp-x-name" aria-expanded="false" aria-describedby="bvp-tip-4">Limescale</button>
          <span class="bvp-x-tip" role="tooltip" id="bvp-tip-4">The white crust. Coats hair and blocks moisture.</span>
        </li>
        <li class="bvp-x-item">
          <span class="bvp-x-ico" aria-hidden="true"></span>
          <button type="button" class="bvp-x-name" aria-expanded="false" aria-describedby="bvp-tip-5">Heavy metals</button>
          <span class="bvp-x-tip" role="tooltip" id="bvp-tip-5">Invisible, and absorbed by your skin daily.</span>
        </li>
        <li class="bvp-x-item">
          <span class="bvp-x-ico" aria-hidden="true"></span>
          <button type="button" class="bvp-x-name" aria-expanded="false" aria-describedby="bvp-tip-6">Odors</button>
          <span class="bvp-x-tip" role="tooltip" id="bvp-tip-6">That musty, metallic smell in hot steam.</span>
        </li>
        <li class="bvp-x-item">
          <span class="bvp-x-ico" aria-hidden="true"></span>
          <button type="button" class="bvp-x-name" aria-expanded="false" aria-describedby="bvp-tip-7">Cloudy minerals</button>
          <span class="bvp-x-tip" role="tooltip" id="bvp-tip-7">Hard water. The reason hair feels like straw.</span>
        </li>
        <li class="bvp-x-item">
          <span class="bvp-x-ico" aria-hidden="true"></span>
          <button type="button" class="bvp-x-name" aria-expanded="false" aria-describedby="bvp-tip-8">The pool smell</button>
          <span class="bvp-x-tip" role="tooltip" id="bvp-tip-8">Chlorine fumes you breathe in every shower.</span>
        </li>
      </ul>
      <a class="bvp-btn-outline" href="#bv-buy">Choose yours<span class="bvp-arrow" aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="bvp-solution-media">
      <img src="{{ 'bvp-solution-hair.jpg' | asset_url }}" width="1024" height="1536" loading="lazy" alt="Detangling wet hair with a wide-tooth comb">
    </div>
  </section>

  {% # ================= BEFORE / AFTER ================= %}
  <section class="bvp-proof" aria-labelledby="bvp-proof-title">
    {% # Wavy top edge: the mist band rides up over the section above it, with a %}
    {% # soft shadow drawn inside the SVG (clipped so it only falls on the white). %}
    <div class="bvp-wave-top" aria-hidden="true">
      <svg viewBox="0 0 1440 64" preserveAspectRatio="none" focusable="false">
        <defs>
          <filter id="bvWaveTopBlur" x="-5%" y="-60%" width="110%" height="220%">
            <feGaussianBlur stdDeviation="4"/>
          </filter>
          <clipPath id="bvWaveTopClip">
            <path d="M0 0 L1440 0 L1440 34 C 1360 44 1260 30 1100 22 C 900 12 740 30 540 40 C 340 50 180 24 0 38 Z"/>
          </clipPath>
        </defs>
        <path fill="#EAF7FB" d="M0 64 L0 38 C 180 24 340 50 540 40 C 740 30 900 12 1100 22 C 1260 30 1360 44 1440 34 L1440 64 Z"/>
        <path d="M0 38 C 180 24 340 50 540 40 C 740 30 900 12 1100 22 C 1260 30 1360 44 1440 34" fill="none" stroke="rgba(10,37,64,0.20)" stroke-width="12" filter="url(#bvWaveTopBlur)" clip-path="url(#bvWaveTopClip)"/>
      </svg>
    </div>
    <h2 id="bvp-proof-title" class="bvp-serif bvp-center">Calm skin, from the very first shower.</h2>
    <div class="bvp-proof-scroll" role="list">
      <figure class="bvp-proof-tile" role="listitem">
        <div class="bvp-proof-media"><img src="{{ 'bvp-proof-skin-front.jpg' | asset_url }}" width="1200" height="1200" loading="lazy" alt="Before and after: red, breaking-out skin on the left, calm clear skin on the right"></div>
        <figcaption>&ldquo;Dandruff, dry skin, acne, hair loss. This has made my hair and skin soft and stopped the peeling. Acne is drastically reduced.&rdquo;<span class="bvp-proof-meta"><span class="bvp-proof-who">Vanessa R.</span><span class="bvp-review-flag bvp-review-flag--proof">&#10003; Verified buyer</span></span></figcaption>
      </figure>
      <figure class="bvp-proof-tile" role="listitem">
        <div class="bvp-proof-media"><img src="{{ 'bvp-proof-skin-cheek.jpg' | asset_url }}" width="1200" height="1200" loading="lazy" alt="Before and after close-up: irritated cheek on the left, smooth even skin on the right"></div>
        <figcaption>&ldquo;The skin feels so soft, and the itching I had for so long is gone.&rdquo;<span class="bvp-proof-meta"><span class="bvp-proof-who">Olga Vazquez</span><span class="bvp-review-flag bvp-review-flag--proof">&#10003; Verified buyer</span></span></figcaption>
      </figure>
      <figure class="bvp-proof-tile" role="listitem">
        <div class="bvp-proof-media"><img src="{{ 'bvp-proof-hair-shine.jpg' | asset_url }}" width="1200" height="1200" loading="lazy" alt="Before and after: dull frizzy hair on the left, soft glossy waves on the right"></div>
        <figcaption>&ldquo;My hair feels softer, not like a Brillo pad anymore.&rdquo;<span class="bvp-proof-meta"><span class="bvp-proof-who">Rachel Donovan</span><span class="bvp-review-flag bvp-review-flag--proof">&#10003; Verified buyer</span></span></figcaption>
      </figure>
      <figure class="bvp-proof-tile" role="listitem">
        <div class="bvp-proof-media"><img src="{{ 'bvp-proof-skin-profile.jpg' | asset_url }}" width="1200" height="1200" loading="lazy" alt="Before and after profile: textured, inflamed cheek on the left, smooth calm skin on the right"></div>
        <figcaption>&ldquo;Skin feels much smoother instantly. No chlorine fumes as I shower.&rdquo;<span class="bvp-proof-meta"><span class="bvp-proof-who">Eddy Oviedo</span><span class="bvp-review-flag bvp-review-flag--proof">&#10003; Verified buyer</span></span></figcaption>
      </figure>
      <figure class="bvp-proof-tile" role="listitem">
        <div class="bvp-proof-media"><img src="{{ 'bvp-proof-skin-glow.jpg' | asset_url }}" width="1200" height="1200" loading="lazy" alt="Before and after: blotchy irritated skin on the left, clear glowing skin on the right"></div>
        <figcaption>&ldquo;Noticeable difference. Skin is softer, skin feels cleaner, hair is less frizzy.&rdquo;<span class="bvp-proof-meta"><span class="bvp-proof-who">K. Olivarez</span><span class="bvp-review-flag bvp-review-flag--proof">&#10003; Verified buyer</span></span></figcaption>
      </figure>
      <figure class="bvp-proof-tile" role="listitem">
