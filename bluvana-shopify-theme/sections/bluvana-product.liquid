  {% if bvp_cart3_variant %}
    <script type="application/json" data-bvp-cart-variant>
      {"id": {{ bvp_cart3_variant.id }}, "price": {{ bvp_cart3_variant.price }}, "available": {{ bvp_cart3_variant.available }}}
    </script>
  {% endif %}

  <script type="application/json" data-bvp-variants>
    [
      {% assign ci0 = color_index | minus: 1 %}
      {% for variant in product.variants %}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price }},
          "available": {% if product.handle == 'shower-filter' and ci0 >= 0 and variant.options[ci0] == 'Gold' %}false{% else %}{{ variant.available }}{% endif %},
          "mediaId": {{ variant.featured_media.id | default: 'null' }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</div>

