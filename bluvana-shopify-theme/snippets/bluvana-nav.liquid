{%- doc -%}
  Bluvana navigation, aesop.com pattern.

  @param {string} mode - 'desktop' renders the centered link row with a boxed
  predictive search; 'mobile' renders the hamburger and slide-in drawer.

  Category URLs fall back to /collections/all until real collections exist.
{%- enddoc -%}

{% liquid
  assign shop_all = routes.all_products_collection_url
  assign new_in_url = shop_all | append: '?sort_by=created-descending'
%}

{% if mode == 'desktop' %}
  <nav class="bv-nav" aria-label="Primary" data-bv-nav>
    <ul class="bv-nav-list" role="list">
      <li><a class="bv-nav-link" href="{{ shop_all }}">Shop all</a></li>
      <li><a class="bv-nav-link" href="{{ new_in_url }}">New in</a></li>
      <li><a class="bv-nav-link" href="{{ shop_all }}">Vanity and sink</a></li>
      <li><a class="bv-nav-link" href="{{ shop_all }}">Shower and bath</a></li>
      <li><a class="bv-nav-link" href="{{ shop_all }}">Walls and storage</a></li>
      <li><a class="bv-nav-link" href="{{ shop_all }}">Finishing touches</a></li>
      <li><a class="bv-nav-link" href="/pages/about">About</a></li>
    </ul>
    <div class="bv-boxsearch" data-bv-search data-suggest-url="{{ routes.predictive_search_url }}" data-search-url="{{ routes.search_url }}">
      <form class="bv-boxsearch-form" action="{{ routes.search_url }}" method="get" role="search">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.75" cy="8.75" r="6"/><path d="m13.2 13.2 4.3 4.3"/></svg>
        <input
          class="bv-boxsearch-input"
          type="search"
          name="q"
          placeholder="Search..."
          aria-label="Search products"
          autocomplete="off"
        >
      </form>
      <div class="bv-search-results" role="region" aria-label="Search suggestions" hidden></div>
    </div>
  </nav>
{% elsif mode == 'mobile_panel' %}
  {% # Panel + scrim render at body level (see layout/theme.liquid): the sticky header %}
  {% # gets view-transition-name when active, which captures position:fixed children. %}
  <div class="bv-mob-scrim" data-bv-mob-scrim hidden></div>
  <div class="bv-mob-panel" id="bv-mob-panel" hidden>
      <div class="bv-mob-head">
        <img src="{{ 'bluvana-wordmark-navy.png' | asset_url }}" width="122" height="26" alt="Bluvana" style="width: 122px; height: auto;">
        <button type="button" class="bv-mob-close" aria-label="Close menu">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4 4l12 12M16 4L4 16"/></svg>
        </button>
      </div>
      <form class="bv-mob-search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="search" name="q" placeholder="Search products" aria-label="Search products" autocomplete="off">
        <button type="submit" aria-label="Search">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.75" cy="8.75" r="6"/><path d="m13.2 13.2 4.3 4.3"/></svg>
        </button>
      </form>
      <nav aria-label="Mobile navigation">
        <p class="bv-mob-label">Shop</p>
        <a href="{{ shop_all }}">Shop all</a>
        {% for product in collections.all.products limit: 8 %}
          <a href="{{ product.url }}">{{ product.title }}</a>
        {% endfor %}
        <p class="bv-mob-label">Company</p>
        <a href="/pages/about">About</a>
        <a href="/pages/contact">Contact us</a>
      </nav>
      <a class="bv-mob-phone" href="tel:+18005550199">
        <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M4.2 2.8h3l1.5 3.7-1.9 1.5a12 12 0 0 0 5.2 5.2l1.5-1.9 3.7 1.5v3a1.8 1.8 0 0 1-2 1.8A15.2 15.2 0 0 1 2.4 4.8a1.8 1.8 0 0 1 1.8-2Z"/></svg>
        (800) 555-0199
      </a>
    </div>
{% endif %}

{% if mode == 'mobile' %}
  <span class="bv-mob">
    <button type="button" class="bv-burger" aria-expanded="false" aria-controls="bv-mob-panel" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </span>
{% endif %}
